# Copy to .env and fill in. .env is git-ignored.

# --- Auth ---
# JWT_SECRET=            # falls back to Rails secret_key_base if unset
# Comma-separated allowlist of frontend hosts a SIWE (wallet login) message's
# `domain` field must match (default: auth.sola.day,auth.juluo.xyz). See
# AuthController::ALLOWED_SIWE_DOMAINS.
# ALLOWED_SIWE_DOMAINS=

# --- Email (Resend) ---
# Delivery is via Resend in production (config/environments/production.rb).
RESEND_API_KEY=
# From-address for all outgoing mail (default: "Social Layer <send@app.sola.day>")
MAIL_FROM=
# Logo shown in the email header (absolute URL)
MAIL_LOGO_URL=
# Public web app base URL, used in email links + the .ics UID (default: https://app.sola.day)
WEB_URL=
# Host used by ActionMailer URL helpers in production (default: app.sola.day)
APP_HOST=

# --- Background jobs (GoodJob) ---
# Jobs run inside the Puma process (config/initializers/good_job.rb), so this
# is how many job threads share the machine with the web threads. Raising it
# also widens the Active Record pool — config/database.yml sizes the pool as
# RAILS_MAX_THREADS + GOOD_JOB_MAX_THREADS + 2.
# GOOD_JOB_MAX_THREADS=  # default 5

# --- Image upload (Cloudflare R2, served at datastore.sola.day) ---
# See app/services/object_store.rb. Same bucket sails wrote to, so new uploads
# share the namespace of every existing image; one bucket serves SG and CN.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_HOST=          # R2 S3 endpoint, e.g. <account>.r2.cloudflarestorage.com
AWS_BUCKET=        # sola
S3_URL=            # public custom domain, e.g. https://datastore.sola.day/

# --- Discussion boards ---
# Gates every /api/v1/{categories,topics,replies} endpoint per deployment; they
# 404 without it, the same way the phone-auth routes do. A group additionally
# has to turn on its own `discussion_enabled` before anything is reachable.
# DISCUSSION_ENABLED=true

# --- Polls ---
# Gates every /api/v1/polls endpoint the same way; a group additionally has to
# turn on its own `poll_enabled`.
# POLL_ENABLED=true

# --- Payments (Stripe) ---
# Per-organizer keys live in the stripe_settings table (encrypted), not here —
# see design/PAYMENTS_PLAN.md. STRIPE_ENABLED gates the whole feature per
# deployment (SG only; CN leaves it unset).
# STRIPE_ENABLED=true
# API_URL=https://api.sola.day   # backend's own public origin, used for Stripe webhook URLs
# NEXT_TOKEN=            # shared secret for the set_payment_status webhook
# Hackathons: same two-switch gate; a group also has to turn on hackathon_enabled.
# HACKATHON_ENABLED=true
