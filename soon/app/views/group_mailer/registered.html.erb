<h1 style="margin: 0 0 12px; font-size: 20px; color: #111827;">A new group registered</h1>
<p style="margin: 0 0 16px; color: #4b5563;">
  <strong><%= @group.display_name %></strong> was just created on <%= MailerHelper::BRAND_NAME %>.
</p>

<table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%; margin: 0 0 16px;">
  <tr>
    <td style="padding: 6px 0; color: #6b7280;">Handle</td>
    <td style="padding: 6px 0; color: #111827; text-align: right;"><%= @group.name %></td>
  </tr>
  <% if @owner %>
  <tr>
    <td style="padding: 6px 0; color: #6b7280;">Owner</td>
    <td style="padding: 6px 0; color: #111827; text-align: right;"><%= @owner.nickname.presence || @owner.name || @owner.id %></td>
  </tr>
  <% end %>
  <% if @group.parent %>
  <tr>
    <td style="padding: 6px 0; color: #6b7280;">Parent group</td>
    <td style="padding: 6px 0; color: #111827; text-align: right;"><%= @group.parent.display_name %></td>
  </tr>
  <% end %>
  <tr>
    <td style="padding: 6px 0; color: #6b7280;">Created</td>
    <td style="padding: 6px 0; color: #111827; text-align: right;"><%= @group.created_at.strftime("%b %-d, %Y · %H:%M UTC") %></td>
  </tr>
</table>

<% if @group.bio.present? %>
  <p style="margin: 12px 0; padding: 12px 16px; background: #f9fafb; border-left: 3px solid #d1d5db; color: #4b5563;">
    <%= @group.bio %>
  </p>
<% end %>

<%= cta_button "View group", @group_url %>

<p style="margin: 0; color: #6b7280; font-size: 13px;">
  You're receiving this because your account is a platform administrator.
</p>
