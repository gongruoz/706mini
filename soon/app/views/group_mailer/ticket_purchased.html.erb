<h1 style="margin: 0 0 12px; font-size: 20px; color: #111827;">New ticket purchase</h1>
<p style="margin: 0 0 16px; color: #4b5563;">
  A ticket for <strong><%= @group.display_name %></strong> was just purchased.
</p>

<table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%; margin: 0 0 16px;">
  <tr>
    <td style="padding: 6px 0; color: #6b7280;">Ticket</td>
    <td style="padding: 6px 0; color: #111827; text-align: right;"><%= @ticket_item.ticket&.title %></td>
  </tr>
  <% if @buyer %>
  <tr>
    <td style="padding: 6px 0; color: #6b7280;">Buyer</td>
    <td style="padding: 6px 0; color: #111827; text-align: right;"><%= @buyer.name %></td>
  </tr>
  <% end %>
  <tr>
    <td style="padding: 6px 0; color: #6b7280;">Amount</td>
    <td style="padding: 6px 0; color: #111827; text-align: right;"><%= @ticket_item.amount %></td>
  </tr>
</table>

<%= cta_button "View group", "#{MailerHelper::WEB_URL}/group/#{@group.name}" %>
