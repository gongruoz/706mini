<h1 style="margin: 0 0 12px; font-size: 20px; color: #111827;">New feedback</h1>
<p style="margin: 0 0 8px; color: #4b5563;">
  <strong><%= @author.name %></strong> left feedback on <strong><%= @item.try(:title) || "your item" %></strong>:
</p>
<p style="margin: 12px 0 20px; padding: 12px 16px; background: #f9fafb; border-left: 3px solid #d1d5db; color: #111827;">
  <%= @comment.content %>
</p>
<% if @item.is_a?(Event) %>
  <%= cta_button "View event", "#{MailerHelper::WEB_URL}/event/detail/#{@item.id}" %>
<% end %>
