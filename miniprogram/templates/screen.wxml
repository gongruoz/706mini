   <button wx:if="{{entityContent.account}}" class="entity-account" bindtap="openOfficial"><view class="grow"><text class="entity-link-title">{{entityContent.account.label}}</text><text class="meta">{{locale === 'en' ? 'WeChat official account' : '空间公众号'}}</text></view><text class="quiet-chevron" aria-hidden="true">›</text></button>
   <view wx:else class="entity-missing"><text class="entity-link-title">{{locale === 'en' ? 'WeChat official account' : '空间公众号'}}</text><text class="meta">{{locale === 'en' ? 'The account has not been added yet.' : '空间尚未提供公众号信息。'}}</text></view>
  </view>
  <view class="entity-stories"><view class="section-heading"><text>{{locale === 'en' ? 'Stories from this space' : '空间回顾'}}</text><button wx:if="{{entityContent.recaps.length > 2}}" class="text-button" bindtap="toggleRecaps">{{showAllRecaps ? (locale === 'en' ? 'Show less' : '收起') : t.view}}</button></view><text wx:if="{{!entityContent.recaps.length}}" class="body-text meta">{{locale === 'en' ? 'This space has not published any stories yet.' : '空间还没有发布往期活动回顾。'}}</text><block wx:for="{{entityContent.recaps}}" wx:key="label"><button wx:if="{{showAllRecaps || index < 2}}" class="entity-recap" data-index="{{index}}" bindtap="openRecap"><view class="grow"><text class="entity-link-title">{{item.label}}</text><text class="meta">{{item.published_at}}{{item.demo ? (locale === 'en' ? ' · Demo story' : ' · 演示文章') : ''}}</text></view><image wx:if="{{item.cover_url}}" src="{{item.cover_url}}" mode="aspectFill"/></button></block></view>
  <view class="section-heading entity-events-heading"><text>{{locale === 'en' ? 'Upcoming events' : '近期活动'}}</text><button class="text-button" data-route="entity-events" data-id="{{record.id}}" bindtap="navigate">{{t.view}}</button></view>
  <text wx:if="{{!items.length && !loading}}" class="body-text meta">{{locale === 'en' ? 'No upcoming events yet. Past events are available in the full list.' : '近期还没有活动，可以在全部活动中查看过往记录。'}}</text>
