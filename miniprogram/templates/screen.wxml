 <block wx:if="{{route === 'event-access' && record}}">
  <view class="access-hero"><text class="success-mark">{{record.status === 'CONFIRMED' || record.status === 'APPROVED_AWAITING_PAYMENT' ? '✅' : '⏳'}}</text><text class="hero-title">{{record.status === 'CONFIRMED' ? (locale === 'en' ? 'You can participate now' : '你可以参加了') : record.status === 'APPROVED_AWAITING_PAYMENT' ? (locale === 'en' ? 'Application approved' : '报名申请已通过') : record.statusLabel}}</text><text class="body-text">{{record.event.title}}</text><text class="meta">{{record.event.dateLabel}}–{{record.event.endTime}} · {{record.event.venue_display}}</text></view>
  <view wx:if="{{record.status === 'CONFIRMED' || record.status === 'APPROVED_AWAITING_PAYMENT'}}" class="section"><text class="section-title">{{locale === 'en' ? 'Next steps' : '下一步'}}</text>
   <view wx:if="{{record.status === 'APPROVED_AWAITING_PAYMENT'}}" class="next-step"><text class="step-number">1</text><view class="grow"><text class="section-title">{{locale === 'en' ? 'Complete payment' : '完成活动付款'}}</text><text class="meta">{{record.event.feeLabel}} · {{locale === 'en' ? 'Complete within 30 minutes' : '请在 30 分钟内完成'}}
{{locale === 'en' ? 'Pay by' : '付款截止'}} {{paymentDeadline}}</text></view><button class="small" data-kind="payment" bindtap="sheet">{{locale === 'en' ? 'Pay' : '去付款'}}</button></view>
   <view wx:if="{{accessHasGroup || record.status === 'APPROVED_AWAITING_PAYMENT'}}" class="next-step"><text class="step-number">{{record.status === 'APPROVED_AWAITING_PAYMENT' ? '2' : '1'}}</text><view class="grow"><text class="section-title">{{locale === 'en' ? 'Join the event group' : '加入活动微信群'}}</text><text class="meta">{{record.status === 'CONFIRMED' ? (locale === 'en' ? 'Your group QR is available. The group shares event reminders.' : '二维码已开放；群内会发布行前提醒。') : (locale === 'en' ? 'The QR will be available after payment. The group shares event reminders.' : '付款后显示二维码；群内会发布行前提醒。')}}</text></view><button class="small" disabled="{{record.status !== 'CONFIRMED'}}" data-kind="group" bindtap="sheet">{{locale === 'en' ? 'View' : '查看'}}</button></view>
   <view wx:if="{{accessHasContact || record.status === 'APPROVED_AWAITING_PAYMENT'}}" class="next-step"><text class="step-number">{{record.status === 'APPROVED_AWAITING_PAYMENT' ? '3' : accessHasGroup ? '2' : '1'}}</text><view class="grow"><text class="section-title">{{locale === 'en' ? 'Contact the organizer' : '联系活动组织者'}}</text><text class="meta">{{record.event.initiator.display_name || record.event.host_display}} · {{record.status === 'CONFIRMED' ? (locale === 'en' ? 'View and copy the organizer contact.' : '可查看、复制组织者联系方式。') : (locale === 'en' ? 'Contact details are available after payment.' : '付款后可查看、复制联系方式。')}}{{record.contact_share_consent ? (locale === 'en' ? ' Your consented contact is shared with the organizer.' : '你报名时同意分享的微信号也会提供给组织者。') : (locale === 'en' ? ' Your WeChat is shared only with your consent at registration.' : '仅在你报名时同意后，才会向组织者提供你的微信号。')}}</text></view><button class="small" disabled="{{record.status !== 'CONFIRMED'}}" data-kind="group" bindtap="sheet">{{locale === 'en' ? 'View' : '查看'}}</button></view>
   <view wx:if="{{accessWillContact}}" class="next-step"><text class="step-number">{{accessHasGroup ? '2' : '1'}}</text><view class="grow"><text class="section-title">{{locale === 'en' ? 'The organizer will contact you' : '组织者稍后会与你联络'}}</text><text class="meta">{{locale === 'en' ? 'See the participation instructions for details.' : '具体安排请查看参与方式。'}}</text></view><button class="small" data-kind="group" bindtap="sheet">{{locale === 'en' ? 'View' : '查看'}}</button></view>
   <text class="body-text meta">{{locale === 'en' ? 'Some events do not provide a group. The organizer may contact you instead.' : '有些活动不会提供群聊。届时这里会说明“组织者稍后会与你联络”，或显示公开联系人。'}}</text>
  </view><button wx:if="{{record.status !== 'CANCELLED' && record.status !== 'EXPIRED'}}" class="secondary access-cancel" data-op="cancelRegistration" bindtap="action">{{t.cancelRegistration}}</button>
 </block>
 <block wx:if="{{route === 'approval-detail' || route === 'campaign-approval-detail'}}"><view wx:if="{{record}}" class="card review-detail">
  <text class="status">{{t[record.status]}}</text><text class="hero-title">{{subject.title}}</text>
  <text class="review-guidance">{{locale === 'en' ? 'Your review: ' : '本次审核身份：'}}{{t[record.scope] || record.scope}}{{locale === 'en' ? '. ' : '。'}}{{subject.reviewGuidance}}</text>
  <image wx:if="{{subject.cover_url}}" class="review-cover" src="{{subject.cover_url}}" mode="aspectFit" data-url="{{subject.cover_url}}" bindtap="previewImage"/>
  <text class="body-text">{{subject.description || subject.introduction}}</text>
  <view class="facts"><text wx:if="{{subject.starts_at}}">{{subject.dateLine}}</text><text>{{subject.venue_display}}</text><text class="meta">{{subject.venue_note}}</text><text wx:if="{{subject.capacity}}">{{subject.capacity}} {{locale === 'en' ? 'places' : '个名额'}} · {{subject.feeLabel}}</text><text wx:if="{{subject.approval_required}}">{{t.approval_required}}</text></view>
  <view wx:if="{{linkedReviewEvents.length}}" class="review-steps"><text class="section-title review-history-title">{{locale === 'en' ? 'Related events' : '关联活动'}}</text><block wx:for="{{linkedReviewEvents}}" wx:key="id"><text wx:if="{{item.unavailable}}" class="body-text meta">{{locale === 'en' ? 'An event could not be loaded: ' : '一场活动暂时无法查看：'}}{{item.error}}</text><button wx:else class="review-event-link" data-id="{{item.id}}" bindtap="openEvent"><text class="section-title">{{item.title}}</text><text class="meta">{{item.dateLine}}</text></button></block></view>
  <text class="section-title review-history-title">{{locale === 'en' ? 'Required reviews' : '必要审核方'}}</text><view wx:for="{{reviewSteps}}" wx:key="id" class="review-step"><text class="status-dot {{item.status === 'APPROVED' ? 'passed' : ''}}"/><view class="grow"><text>{{t[item.scope] || item.scope}}</text><text wx:if="{{item.note}}" class="meta">{{item.note}}</text></view><text class="review-scope">{{t[item.status]}}</text></view>
  <text wx:if="{{subject.organizer_note}}" class="section-title review-history-title">{{locale === 'en' ? 'Organizer notes' : '发起人备注'}}</text><text class="body-text">{{subject.organizer_note}}</text><view wx:if="{{record.status === 'PENDING' && subject.status === 'IN_REVIEW'}}" class="row form-actions"><button class="secondary" disabled="{{busy}}" data-kind="return" bindtap="sheet">{{t.reject}}</button><button class="primary" disabled="{{busy}}" loading="{{busy}}" data-op="review" data-approve="{{true}}" bindtap="action">{{t.approve}}</button></view>
 </view></block>
 <view wx:if="{{route === 'approval-progress' || route === 'campaign-review-progress'}}" class="card"><text class="status">{{record.statusLabel}}</text><text class="hero-title">{{record.title}}</text><text wx:if="{{record.submitted_display}}" class="meta">{{record.submitted_display}}</text><text class="review-guidance">{{record.reviewGuidance}}</text><button wx:if="{{record.status === 'CHANGES_REQUESTED' || record.status === 'DRAFT'}}" class="primary" data-route="{{route === 'campaign-review-progress' ? 'campaign-edit' : 'publish'}}" data-id="{{record.id}}" bindtap="navigate">{{locale === 'en' ? 'Edit and resubmit' : '修改并重新提交'}}</button><text class="section-title review-history-title">{{locale === 'en' ? 'Review records' : '审核记录'}}</text><text wx:if="{{!items.length}}" class="meta">{{locale === 'en' ? 'Review records will appear here after submission.' : '提交审核后，这里会显示每一方的处理记录。'}}</text></view>
 <view wx:if="{{route === 'relations' || route === 'following'}}" class="chips"><button class="chip {{relationMode === 'following' ? 'selected' : ''}}" data-mode="following" bindtap="relationTab">{{t.following}} {{followingCount}}</button><button class="chip {{relationMode === 'followers' ? 'selected' : ''}}" data-mode="followers" bindtap="relationTab">{{t.followers}} {{followersCount}}</button></view>
 <view wx:if="{{formKind && submitted}}" class="success-page"><text class="success-icon">🎉</text><text class="hero-title">{{formKind === 'profile' ? (locale === 'en' ? 'Welcome to 706' : '欢迎来到 706 社区') : formKind === 'event' ? (locale === 'en' ? 'Event submitted for review' : '活动已提交审核') : (locale === 'en' ? 'Campaign submitted for review' : '专题已提交审核')}}</text><text class="body-text">{{formKind === 'profile' ? form.display_name + ' · ' + form.bio : (locale === 'en' ? 'The relevant reviewers have received the request. Follow progress below.' : '相应审核方会收到申请。所有必要审核通过后会自动公开。')}}</text><button wx:if="{{formKind !== 'profile'}}" class="primary" data-route="{{formKind === 'event' ? 'approval-progress' : 'campaign-review-progress'}}" data-id="{{submittedId || optionsId}}" bindtap="navigate">{{t.progress}}</button><button class="primary" data-route="feed" bindtap="navigate">{{locale === 'en' ? 'Enter community' : '进入社区'}}</button><button wx:if="{{formKind === 'profile'}}" class="text-button" bindtap="restartForm">{{t.edit}}</button></view>
 <block wx:if="{{formKind && !submitted}}">
  <view wx:if="{{route === 'publish' || route === 'campaign-create' || route === 'onboarding'}}" class="form-intro"><view class="form-progress"><view wx:for="{{formSteps}}" wx:key="number" class="form-stage {{step === item.number ? 'is-current' : step > item.number ? 'is-complete' : ''}}"><text class="stage-number">{{item.number}}</text><text>{{item.title}}</text></view></view><text class="hero-title">{{formSteps[step - 1].title}}</text><text class="body-text meta">{{formSteps[step - 1].description}}</text></view>
  <view class="form card {{route === 'campaign-edit' ? 'series-edit' : ''}}">
   <view wx:for="{{fields}}" wx:key="key" id="field-{{item.key}}" class="field {{item.type === 'switch' ? 'switch-field' : ''}} {{formErrors[item.key] ? 'field-invalid' : ''}}"><text class="label">{{item.label}}<text wx:if="{{item.key === 'avatar_url' || item.key === 'bio' || item.key === 'introduction' && formKind === 'profile' || item.key === 'media' || item.key === 'summary'}}" class="optional-label">{{locale === 'en' ? 'Optional' : '选填'}}</text></text>
    <textarea wx:if="{{item.type === 'area'}}" value="{{form[item.key]}}" data-key="{{item.key}}" bindinput="input" auto-height maxlength="12000"/>
    <switch wx:elif="{{item.type === 'switch'}}" checked="{{form[item.key]}}" data-key="{{item.key}}" bindchange="switchInput"/>
    <view wx:elif="{{item.type === 'datetime'}}" class="row"><picker mode="date" data-key="{{item.key}}" data-part="date" bindchange="dateInput"><view class="picker">{{item.dateDisplay || t.choose}}</view></picker><picker mode="time" data-key="{{item.key}}" data-part="time" bindchange="dateInput"><view class="picker">{{item.timeDisplay || '⏳'}}</view></picker></view>
    <picker wx:elif="{{item.type === 'city'}}" range="{{cities}}" range-key="{{locale === 'en' ? 'en' : 'zh'}}" data-key="{{item.key}}" data-type="city" bindchange="select"><view class="picker select-control"><text>{{item.display || t.choose}}</text><text class="picker-chevron" aria-hidden="true">⌄</text></view></picker>
    <picker wx:elif="{{item.type === 'space'}}" range="{{spaceNames}}" data-key="{{item.key}}" data-type="space" bindchange="select"><view class="picker select-control"><text>{{item.display || t.choose}}</text><text class="picker-chevron" aria-hidden="true">⌄</text></view></picker>
    <picker wx:elif="{{item.type === 'organization'}}" range="{{organizationNames}}" data-key="{{item.key}}" data-type="organization" bindchange="select"><view class="picker select-control"><text>{{item.display || t.personal}}</text><text class="picker-chevron" aria-hidden="true">⌄</text></view></picker>
    <picker wx:elif="{{item.type === 'access'}}" range="{{[t.groupQr,t.organizerWechat,t.organizerContact]}}" data-key="{{item.key}}" data-type="access" bindchange="select"><view class="picker select-control"><text>{{item.display || t.choose}}</text><text class="picker-chevron" aria-hidden="true">⌄</text></view></picker>
