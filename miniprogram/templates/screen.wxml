<template name="eventCard">
 <view aria-hidden="{{modalOpen}}" class="event-card {{large ? 'event-card-large' : ''}} state-{{e.bookingState}}" data-id="{{e.id}}" bindtap="openEvent">
  <view wx:if="{{large}}" class="large-card-art"><image src="{{e.cover_url}}" mode="aspectFill"/><view class="large-card-shade"/><text class="large-card-title">{{e.title}}</text></view>
  <view class="event-main">
   <view class="event-info"><button wx:if="{{interactiveTitle}}" class="event-title event-title-link" data-id="{{e.id}}" catchtap="openEvent">{{e.title}}</button><text wx:else class="event-title">{{e.title}}</text><view class="event-badges"><text class="event-capacity" aria-label="{{e.bookingLabel + ' · ' + e.capacityLabel}}">{{e.bookingLabel}} {{e.capacityDisplay}}</text></view><view class="card-fact"><text class="emoji-icon" aria-hidden="true">{{icons.calendar}}</text><text>{{e.dateLine}}</text></view><view class="card-fact"><text class="emoji-icon" aria-hidden="true">{{icons.location}}</text><text>{{e.venue_display || e.venue_name}}</text></view><view class="card-fact card-fact-host"><text class="emoji-icon" aria-hidden="true">{{icons.group}}</text><text>{{e.hostLine || e.host_display}}</text></view><text class="card-fee">{{e.feeLabel}}</text></view>
   <view class="event-side"><view wx:if="{{e.cover_url}}" class="event-art" role="button" aria-label="{{t.preview}}" data-url="{{e.cover_url}}" catchtap="previewImage"><image class="event-cover" src="{{e.cover_url}}" mode="aspectFill" data-id="{{e.id}}" binderror="coverError"/></view><view wx:else class="event-cover placeholder"><text>706</text><text class="meta">{{t.event}}</text></view></view>
  </view>
 </view>
</template>

<template name="featureCarousel">
 <view class="banner-pages"><swiper current="{{current || 0}}" bindchange="{{isNodes ? 'nodeChange' : 'bannerChange'}}" indicator-dots="{{cards.length > 1}}" indicator-color="rgba(255,255,255,0.45)" indicator-active-color="#ffffff" circular="{{cards.length > 1}}" autoplay="{{false}}" display-multiple-items="1" previous-margin="0px" next-margin="0px" class="campaign-swiper" aria-label="{{isNodes ? (locale === 'en' ? 'City and followed spaces' : '城市与已关注节点') : (locale === 'en' ? 'Event series' : '活动专题')}}">
  <swiper-item wx:for="{{cards}}" wx:key="id"><view class="campaign-slide" data-route="{{isNodes ? 'space' : 'campaign'}}" data-id="{{item.id}}" bindtap="navigate">
   <image wx:if="{{item.cover_url}}" src="{{item.cover_url}}" class="campaign-background" mode="aspectFill"/><view class="campaign-shade"/>
   <view class="campaign-copy"><text class="banner-kicker">{{isNodes ? item.context + (item.city !== city ? ' · ' + item.cityLabel : '') : item.kicker}}</text><text class="banner-title">{{item.title}}</text><text class="banner-description">{{isNodes ? item.summary : item.banner_description || item.introduction}}</text></view>
  </view></swiper-item>
 </swiper></view>
</template>
<view class="screen page-{{route}} {{demo && reviewIndex >= 0 ? 'reviewing' : ''}} {{route === 'event' ? 'has-bottom' : ''}}" style="{{theme}};padding-top:{{headerHeight + (demo && reviewIndex >= 0 ? 56 : 0)}}px">
 <view class="main-navigation" style="height:{{headerHeight}}px;padding-top:{{menuTop}}px"><view class="main-navigation-content" style="height:{{menuHeight}}px;padding-right:{{menuRightInset}}px"><button wx:if="{{!isMainTab}}" class="header-back" aria-label="{{locale === 'en' ? 'Back' : '返回'}}" bindtap="back">‹</button><text wx:if="{{!isMainTab}}" class="subpage-title">{{title}}</text><button wx:if="{{route === 'feed' || route === 'discover'}}" class="city" aria-label="{{locale === 'en' ? 'Change city: ' + cityName : '切换城市：' + cityName}}" bindtap="chooseCity">{{cityName}}</button><view wx:if="{{route === 'discover'}}" class="search-capsule"><input value="{{query}}" placeholder="{{t.search}}" bindinput="searchInput" bindconfirm="search" confirm-type="search"/><button class="search-submit" aria-label="{{t.search}}" bindtap="search">{{icons.search}}</button></view><scroll-view wx:if="{{route === 'messages'}}" scroll-x class="header-message-filters" style="height:{{menuHeight}}px;line-height:{{menuHeight}}px" show-scrollbar="{{false}}" aria-label="{{locale === 'en' ? 'Message categories' : '消息分类'}}"><button wx:for="{{['','ADMIN','EVENT','SOCIAL']}}" wx:key="*this" class="chip {{(category || '') === item ? 'selected' : ''}}" data-value="{{item}}" bindtap="category">{{t[item] || t.all}}</button></scroll-view></view></view>
 <view wx:if="{{demo && reviewIndex >= 0}}" class="review-controls" style="top:{{headerHeight}}px"><button class="small" data-delta="-1" bindtap="reviewNext">‹</button><text>{{reviewIndex + 1}} / 118</text><button class="small" data-delta="-1" bindtap="reviewScroll">⬆️</button><button class="small" data-delta="1" bindtap="reviewScroll">⬇️</button><button class="small" data-delta="1" bindtap="reviewNext">›</button></view>
 <block wx:if="{{route === 'review-lab'}}"><view class="card developer-tools"><text class="hero-title">{{locale === 'en' ? 'Developer' : '开发者'}}</text><text class="meta">{{demo ? (locale === 'en' ? 'Demo data · ' : '演示数据 · ') + demoName : 'Montana'}}</text><button class="secondary" bindtap="labMode">{{demo ? (locale === 'en' ? 'Connect live service' : '切换真实服务') : (locale === 'en' ? 'Use demo data' : '切换演示数据')}}</button><view wx:if="{{demo}}" class="chips developer-personas"><button wx:for="{{developerPersonas}}" wx:key="id" class="chip {{currentUser === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="labPersona">{{item.label}}</button></view></view></block>
 <block wx:if="{{route === 'review-lab'}}"><view class="card"><text class="hero-title">待查看页面</text><text class="body-text">12 项待修、32 项待核对、4 个额外路由，共 48 项。已核对的 19 项不列入；开发核对不代表本人验收。</text><text class="meta">点击切换到对应演示身份与上海筛选，保留 r12 业务记录与草稿，不重置数据。从“我的 → 开发者”返回页面目录。</text><button wx:if="{{!demo}}" class="secondary" bindtap="labMode">切换到离线演示后查看</button></view><view wx:if="{{demo}}" class="menu"><view wx:for="{{pendingCatalog}}" wx:key="index"><button class="menu-item catalog-button" data-index="{{item.index}}" data-pending="{{true}}" bindtap="labOpen">{{item.label}}　›</button><text wx:if="{{item.note}}" class="meta">{{item.note}}</text></view></view></block>

 <view wx:if="{{error}}" class="error" role="alert"><text>{{error}}</text><button class="small" disabled="{{busy}}" bindtap="{{needsLogin ? 'login' : 'load'}}">{{needsLogin ? t.login : t.retry}}</button></view>
 <view wx:if="{{loading && !items.length && !record}}" class="skeleton" aria-label="{{t.loading}}"><text class="meta">{{t.loading}}</text><view/><view/><view/></view>
 <block wx:if="{{route === 'feed'}}">
  <view wx:if="{{nodeCards.length || nodesError}}" class="node-shelf">
   <template is="featureCarousel" data="{{cards:nodeCards,isNodes:true,current:nodeIndex,city:city,locale:locale}}"/>
   <view wx:if="{{nodesError}}" class="node-load-note"><text>{{nodesError}}</text><button class="text-button" bindtap="retryNodes">{{t.retry}}</button></view>
  </view>
  <view class="section-heading people-heading"><text>{{t.people}}</text><button class="text-button people-refresh" bindtap="refreshPeople">{{t.refresh}}</button></view>
  <scroll-view scroll-x class="people-strip discovery-people" enhanced show-scrollbar="{{false}}"><view class="person person-capsule" wx:for="{{people}}" wx:key="owner"><text class="person-reason">{{locale !== 'en' && item.reason_text ? item.reason_text : t[item.reason]}}</text><view class="person-content" data-route="member" data-id="{{item.owner}}" bindtap="navigate"><image class="avatar" src="{{item.avatar_url}}"/><view class="person-copy"><view class="person-name-row"><text class="person-name">{{item.display_name}}</text><button class="small person-follow {{item.following ? 'is-following' : ''}}" data-id="{{item.owner}}" data-enabled="{{!item.following}}" catchtap="personFollow">{{item.following ? (locale === 'en' ? 'Following' : '已关注') : t.follow}}</button></view><text class="meta">{{item.bio}}</text></view></view></view></scroll-view>
 </block>
 <block wx:if="{{route === 'discover' || route === 'calendar'}}">
  <template wx:if="{{route === 'discover' && campaigns.length}}" is="featureCarousel" data="{{cards:campaigns,isNodes:false,current:bannerIndex,city:city,locale:locale}}"/>
  <view wx:if="{{route === 'discover'}}" class="calendar-entry" data-route="calendar" bindtap="navigate"><text class="section-title">{{t.calendar}}</text><text class="meta">{{locale === 'en' ? 'This week · ' + calendarSummarySpaces + ' spaces · ' + calendarSummaryTotal + ' events' : '本周 ' + calendarSummarySpaces + ' 个空间 · ' + calendarSummaryTotal + ' 场活动'}}</text></view>
  <view class="filters">
   <view class="filter-group"><view class="chips filter-options"><button class="chip {{calendarMode === 'week' && offset === 0 ? 'selected' : ''}}" data-key="date" data-value="week" bindtap="filter">{{t.week}}</button><button wx:if="{{route === 'discover'}}" class="chip {{offset === 1 ? 'selected' : ''}}" data-key="date" data-value="next" bindtap="filter">{{t.nextWeek}}</button><button wx:else class="chip {{calendarMode === 'month' ? 'selected' : ''}}" data-mode="month" bindtap="calendarMode">{{t.month}}</button></view><button wx:if="{{route === 'calendar'}}" class="small calendar-export" loading="{{busy}}" bindtap="poster">{{t.poster}}</button></view>
   <view wx:if="{{route === 'calendar'}}" class="calendar-heading calendar-period"><button class="icon-button" data-delta="-1" bindtap="period" aria-label="{{t.previous}}">‹</button><text>{{calendarMode === 'month' ? monthLabel : rangeLabel}}</text><button class="icon-button" data-delta="1" bindtap="period" aria-label="{{t.next}}">›</button></view>
   <view class="filter-group"><scroll-view scroll-x class="chips filter-options"><button class="chip {{!filters.space_id ? 'selected' : ''}}" data-key="space_id" data-value="" bindtap="filter">{{t.allSpaces}}</button><button wx:for="{{spaces}}" wx:key="id" class="chip {{filters.space_id === item.id ? 'selected' : ''}}" data-key="space_id" data-value="{{item.id}}" bindtap="filter">{{item.name}}</button></scroll-view></view>
   <view class="filter-group"><view class="chips filter-options"><button class="chip {{filters.free_only ? 'selected' : ''}}" aria-pressed="{{!!filters.free_only}}" data-key="free_only" data-value="{{!filters.free_only}}" bindtap="filter">{{t.free}}</button><button class="chip {{filters.has_capacity ? 'selected' : ''}}" aria-pressed="{{!!filters.has_capacity}}" data-key="has_capacity" data-value="{{!filters.has_capacity}}" bindtap="filter">{{t.capacity}}</button></view><button wx:if="{{filters.space_id || filters.free_only || filters.has_capacity || filters.tag}}" class="text-button filter-clear" bindtap="clearFilters">{{locale === 'en' ? 'Reset' : '重置'}}</button></view>
  </view>

  <view wx:if="{{route === 'calendar'}}" aria-hidden="{{!!sheet}}" class="calendar-box {{calendarMode === 'month' ? 'month-calendar' : 'week-calendar'}}"><view class="calendar-grid weekday-row"><text wx:for="{{weekdays}}" wx:key="*this">{{item}}</text></view><view class="calendar-grid"><view wx:for="{{days}}" wx:key="date" class="day {{item.selected ? 'selected' : ''}} {{item.disabled ? 'blank-day' : ''}}"><button class="day-number" aria-label="{{item.date}}" disabled="{{item.disabled}}" data-date="{{item.date}}" bindtap="selectDay">{{item.label}}</button><text class="day-count">{{item.count ? item.count + (locale === 'en' ? '' : ' 场') : ' '}}</text></view></view></view>
  <view wx:if="{{route === 'calendar' && calendarMode === 'month'}}" class="month-legend"><text>● {{locale === 'en' ? 'Has events' : '有活动'}}</text><text>{{total}} {{locale === 'en' ? 'events' : '场活动'}}</text></view>
  <view wx:if="{{route === 'calendar'}}" class="section-heading calendar-results-title"><view><text class="section-title">{{selectedDate || (calendarMode === 'month' ? (locale === 'en' ? 'This month' : '本月活动') : (locale === 'en' ? 'This week' : '本周活动'))}}</text><text class="meta">{{total}} {{locale === 'en' ? (total === 1 ? 'event' : 'events') : '场活动'}}</text></view><button wx:if="{{selectedDate}}" class="text-button" bindtap="clearDate">{{locale === 'en' ? 'All dates' : '返回全部日期'}}</button></view>
  <view wx:if="{{route === 'discover'}}" class="section-heading"><text>{{total}} {{locale === 'en' ? (total === 1 ? 'event' : 'events') : '场活动'}}</text></view>
 </block>

 <block wx:if="{{route === 'me'}}">
  <view wx:if="{{record}}" class="self-profile"><view class="row"><view class="self-identity" data-route="member" data-id="{{currentUser}}" bindtap="navigate"><image class="avatar large" src="{{record.avatar_url}}"/><view><text class="hero-title">{{record.display_name}}</text><text class="meta">{{cityName}} · {{record.bio}}</text></view></view><button class="small" data-route="edit-profile" bindtap="navigate">{{locale === 'en' ? 'Edit profile' : '编辑资料'}}</button></view><view class="self-stats"><button data-route="relations" bindtap="navigate"><text>{{me.following}}</text><text>{{t.following}}</text></button><button data-route="relations" data-extra="{{ {mode: 'followers'} }}" bindtap="navigate"><text>{{me.followers}}</text><text>{{t.followers}}</text></button></view></view>
  <button wx:if="{{me.roles.length}}" class="admin-summary" data-route="approvals" bindtap="navigate"><view><text class="section-title">{{locale === 'en' ? 'Admin tasks' : '管理员待办'}}</text><text class="meta">{{reviewCount ? reviewCount + (locale === 'en' ? ' events or series await review' : ' 个活动或专题正在等待审核') : (locale === 'en' ? 'All reviews complete' : '新的审核都处理完了')}}</text></view><text class="admin-count">{{reviewCount}}</text></button>
  <view wx:for="{{menuGroups}}" wx:key="id" class="settings-menu"><text class="menu-group-title">{{item.title}}</text><button wx:for="{{item.rows}}" wx:for-item="entry" wx:key="label" class="settings-row" data-route="{{entry.route}}" data-id="{{entry.id}}" data-kind="{{entry.kind}}" bindtap="menuEntry"><view class="settings-icon"><text class="emoji-icon" aria-hidden="true">{{icons[entry.icon]}}</text></view><text class="settings-label">{{entry.label}}</text><text class="settings-value">{{entry.value}}</text><text class="settings-chevron">›</text></button></view>
  <view wx:if="{{developerVisible}}" class="settings-menu developer-entry"><button class="settings-row" data-route="review-lab" bindtap="navigate"><view class="settings-icon"><text class="emoji-icon" aria-hidden="true">{{icons.developer}}</text></view><text class="settings-label">{{locale === 'en' ? 'Developer' : '开发者'}}</text><text class="settings-chevron">›</text></button></view>
 </block>
 <block wx:if="{{route === 'more'}}">
  <view class="settings-intro"><text class="hero-title">706 {{locale === 'en' ? 'Community' : '社区'}}</text><text class="body-text">{{locale === 'en' ? 'Community events and information for your language and city.' : '按你的语言和所在城市，提供更合适的活动与社区信息。'}}</text></view>
  <view class="settings-menu"><button class="settings-row" data-route="onboarding" bindtap="navigate"><view class="settings-icon"><text class="emoji-icon" aria-hidden="true">{{icons.new}}</text></view><text class="settings-label">{{locale === 'en' ? 'New member profile' : '新人资料'}}</text><text class="settings-value">{{record.onboarded ? (locale === 'en' ? 'Complete' : '已完成') : (locale === 'en' ? 'Complete profile' : '去完善')}}</text><text class="settings-chevron">›</text></button></view>
  <view class="settings-menu"><button class="settings-row" bindtap="chooseCity"><view class="settings-icon"><text class="emoji-icon" aria-hidden="true">{{icons.city}}</text></view><view class="settings-label"><text>{{t.city}}</text><text class="meta">{{locale === 'en' ? 'Current city' : '当前城市'}}</text></view><text class="settings-value">{{cityName}}</text><text class="settings-chevron">›</text></button><button class="settings-row" data-kind="language" bindtap="sheet"><view class="settings-icon"><text class="emoji-icon" aria-hidden="true">{{icons.language}}</text></view><view class="settings-label"><text>{{t.language}}</text><text class="meta">{{locale === 'en' ? 'Interface language' : '选择界面语言'}}</text></view><text class="settings-value">{{locale === 'en' ? 'English' : '简体中文'}}</text><text class="settings-chevron">›</text></button></view>
  <view class="settings-menu"><button class="settings-row" data-kind="notifications" bindtap="sheet"><view class="settings-icon"><text class="emoji-icon" aria-hidden="true">{{icons.bell}}</text></view><text class="settings-label">{{t.notificationSettings}}</text><text class="settings-value">{{record.notification_preferences.enabled ? (locale === 'en' ? 'On' : '已开启') : (locale === 'en' ? 'Off' : '已关闭')}}</text><text class="settings-chevron">›</text></button><button class="settings-row" data-route="privacy" bindtap="navigate"><view class="settings-icon"><text class="emoji-icon" aria-hidden="true">{{icons.shield}}</text></view><text class="settings-label">{{locale === 'en' ? 'Privacy and security' : '隐私与安全'}}</text><text class="settings-chevron">›</text></button></view>
  <view class="settings-menu"><button class="settings-row" data-kind="about" bindtap="sheet"><view class="settings-icon"><text class="emoji-icon" aria-hidden="true">{{icons.info}}</text></view><text class="settings-label">{{locale === 'en' ? 'About 706 Community' : '关于 706 社区'}}</text><text class="settings-chevron">›</text></button><button class="settings-row" data-route="feedback" bindtap="navigate"><view class="settings-icon"><text class="emoji-icon" aria-hidden="true">{{icons.feedback}}</text></view><text class="settings-label">{{locale === 'en' ? 'Feedback and suggestions' : '反馈与建议'}}</text><text class="settings-chevron">›</text></button></view>
  <button class="settings-logout" bindtap="logout">{{t.logout}}</button>
 </block>
 <block wx:if="{{route === 'event' || route === 'activity-preview'}}">
  <view wx:if="{{record}}"><image wx:if="{{record.cover_url}}" class="detail-cover" src="{{mediaPreviews.cover_url || record.cover_url}}" mode="aspectFill" data-url="{{mediaPreviews.cover_url || record.cover_url}}" bindtap="previewImage"/><view class="detail-intro"><text class="event-status state-{{record.bookingState}}">{{record.bookingLabel}}</text><text class="hero-title">{{record.title}}</text><text class="body-text">{{record.cityLabel}} · {{record.hostLine}}</text></view>
   <view class="detail-facts">
    <view class="detail-fact"><text class="emoji-icon" aria-hidden="true">{{icons.calendar}}</text><view class="grow"><text class="fact-main">{{record.dateLine}}</text><text class="meta">{{locale === 'en' ? 'Registration closes 2 hours before the event' : '活动开始前 2 小时停止报名'}}</text></view></view>
    <view class="detail-fact detail-location" data-route="space" data-id="{{record.space_id}}" bindtap="navigate"><text class="emoji-icon" aria-hidden="true">{{icons.location}}</text><view class="grow"><text class="fact-main">{{record.venue_display || record.venue_name}}</text><text class="meta">{{record.address}}</text></view><text wx:if="{{record.space_id}}" aria-hidden="true">›</text></view>
    <view class="detail-fact"><text class="emoji-icon" aria-hidden="true">{{icons.ticket}}</text><view class="grow"><text class="fact-main">{{record.price_minor ? record.feeLabel + (locale === 'en' ? ' / person' : ' / 人') : (locale === 'en' ? 'Free admission' : '免费参加')}}</text><text class="meta">{{!record.bookingOpen ? record.bookingLabel : record.remaining == null ? t.unlimited : (locale === 'en' ? record.remaining + ' places left' : '还剩 ' + record.remaining + ' 个名额')}}</text></view></view>
   </view>
   <view wx:if="{{route === 'event' && record.registered}}" class="detail-social"><view class="avatar-stack"><image wx:for="{{record.detailParticipants}}" wx:key="owner" class="stack-avatar" src="{{item.avatar_url}}" data-route="member" data-id="{{item.owner}}" bindtap="navigate"/></view><text>{{record.capacityDisplay}} {{locale === 'en' ? 'attending' : '人参加'}}</text></view>
   <view wx:if="{{record.campaigns.length}}" class="detail-series-links"><text class="meta">{{locale === 'en' ? 'Part of a series' : '所属专题'}}</text><button wx:for="{{record.campaigns}}" wx:key="id" class="text-button" data-route="campaign" data-id="{{item.id}}" bindtap="navigate">{{item.title}} ›</button></view>
   <view class="section"><text class="section-title">{{locale === 'en' ? 'About this event' : '关于活动'}}</text><text class="body-text">{{record.summary}}</text><text wx:if="{{record.description && record.description !== record.summary}}" class="body-text">{{record.description}}</text><view class="chips"><text wx:for="{{record.tags}}" wx:key="*this" class="chip">{{item}}</text></view></view><view wx:if="{{route === 'event' && record.fit_description}}" class="section"><text class="section-title">{{locale === 'en' ? 'Who is it for' : '适合谁参加'}}</text><text class="body-text">{{record.fit_description}}</text></view>
   <view wx:if="{{route === 'event'}}" class="section"><text class="section-title">{{t.organizer}}</text><button class="member-row" data-route="member" data-id="{{record.owner}}" bindtap="navigate"><image class="avatar" src="{{record.initiator.avatar_url}}"/><view class="grow"><text class="section-title">{{record.initiator.display_name || record.host_display}}</text><text class="meta">{{locale === 'en' ? 'Host · ' + record.host_recent_count + ' recent events' : '发起人 · 最近组织 ' + record.host_recent_count + ' 场活动'}}</text></view><text>›</text></button><button class="member-row" data-route="space" data-id="{{record.space_id}}" bindtap="navigate"><view class="venue-mark"><text class="emoji-icon" aria-hidden="true">{{icons.home}}</text></view><view class="grow"><text class="section-title">{{record.venue_display || record.venue_name}}</text><text class="meta">{{record.organization_name || t.personal}}</text></view><text>›</text></button></view>
   <view wx:if="{{route === 'event'}}" class="row event-secondary-actions"><button class="text-button" open-type="share">{{locale === 'en' ? 'Share event' : '分享活动'}}</button><button wx:if="{{record.recommended}}" class="text-button" data-op="withdrawRecommendation" bindtap="action">{{t.withdrawRecommendation}}</button><button class="text-button" data-op="clone" bindtap="action">{{t.clone}}</button></view>
   <view wx:if="{{route === 'event'}}" class="section event-discussion"><view class="section-heading"><text>{{t.comments}}</text><button class="small comment-compose" data-kind="comment" bindtap="sheet">{{locale === 'en' ? 'Write a comment' : '写评论'}}</button></view><view wx:for="{{detailThreads}}" wx:key="id" class="comment"><view class="row"><image class="avatar" src="{{item.author.avatar_url}}" data-route="member" data-id="{{item.owner}}" bindtap="navigate"/><text class="section-title" data-route="member" data-id="{{item.owner}}" bindtap="navigate">{{item.author.display_name}}</text><text wx:if="{{item.badge}}" class="attendance-status {{item.badge === '已推荐' || item.badge === 'Recommended' ? 'comment-note-badge' : ''}}">{{item.badge}}</text></view><text class="body-text">{{item.text}}</text><view wx:for="{{item.replies}}" wx:for-item="reply" wx:key="id" class="comment-reply"><text class="reply-author">{{reply.author.display_name}}：</text>{{reply.text}}</view><view class="row comment-actions"><button class="text-button" data-kind="comment" data-reply="{{item.id}}" bindtap="sheet">{{t.reply}}</button><button wx:if="{{item.owner === currentUser}}" class="text-button" data-op="deleteComment" data-id="{{item.id}}" bindtap="action">{{t.delete}}</button></view></view></view>
   <view wx:if="{{route === 'event' && record.can_edit}}" class="event-management"><button class="secondary management-link" data-route="attendees" data-id="{{record.id}}" bindtap="navigate"><text>{{t.attendees}}</text><text class="management-chevron" aria-hidden="true">›</text></button><button class="secondary management-link" data-route="approval-progress" data-id="{{record.id}}" bindtap="navigate"><text>{{t.progress}}</text><text class="management-chevron" aria-hidden="true">›</text></button><button class="danger management-cancel" data-op="cancelEvent" bindtap="action">{{t.cancelEvent}}</button></view>
