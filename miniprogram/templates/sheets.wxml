<view wx:if="{{sheet}}" class="overlay"><view class="scrim" bindtap="closeSheet"/><view class="sheet {{sheet === 'poster' ? 'poster-sheet' : ''}}"><view class="sheet-handle"/><view class="section-heading"><text>{{sheet === 'notifications' ? t.notificationSettings : sheetCopy.titles[sheet] || t.confirm}}{{sheet === 'comment' ? ' · ' + commentCount : ''}}</text><button class="icon-button" aria-label="{{t.close || '关闭'}}" bindtap="closeSheet">✖️</button></view>
 <text wx:if="{{sheetCopy.descriptions[sheet]}}" class="sheet-description">{{sheet === 'group' && record.event.price_minor === 0 ? (locale === 'en' ? 'Your registration is confirmed. View the group and organizer instructions below.' : '你的报名已确认，可查看活动群和组织者的参与说明。') : sheetCopy.descriptions[sheet]}}</text>
 <text wx:if="{{error}}" class="sheet-error" role="alert">{{error}}</text>
 <block wx:if="{{sheet === 'poster'}}"><text class="section-title">{{cityName}} · {{posterTitle}}</text><text class="meta">{{t.posterNotice}}</text><text class="meta">{{posterPeriod}}</text><scroll-view scroll-y class="poster-scroll"><image class="poster-preview" src="{{posterPath}}" mode="widthFix"/></scroll-view><view class="poster-actions"><button class="primary" bindtap="savePoster">{{t.saveImage}}</button><button class="secondary" bindtap="closeSheet">{{t.cancel}}</button></view></block>
 <block wx:elif="{{sheet === 'official' || sheet === 'recap'}}"><text class="hero-title">{{externalContent.label}}</text><text class="external-preview-note">{{demo || externalContent.demo ? (locale === 'en' ? 'Offline demo only. No real account or article is opened.' : '离线演示内容，不会打开真实公众号或文章。') : (locale === 'en' ? 'We could not open this in WeChat. The account may need linking, or this version may not support it.' : '暂时无法在微信内打开，请检查账号关联、文章状态或微信版本。')}}</text><image wx:if="{{externalContent.cover_url}}" class="external-preview-cover" src="{{externalContent.cover_url}}" mode="aspectFill"/><text wx:if="{{externalContent.excerpt}}" class="body-text">{{externalContent.excerpt}}</text><text wx:if="{{externalContent.published_at}}" class="meta">{{externalContent.published_at}}</text><text wx:if="{{externalContent.username && !externalContent.demo}}" class="body-text" selectable>{{externalContent.username}}</text><button wx:if="{{sheet === 'official' && externalContent.username && !demo && !externalContent.demo}}" class="secondary" data-value="{{externalContent.username}}" bindtap="copy">{{locale === 'en' ? 'Copy account ID' : '复制公众号 ID'}}</button><button wx:if="{{sheet === 'recap' && externalContent.url && !demo && !externalContent.demo}}" class="secondary" data-value="{{externalContent.url}}" bindtap="copy">{{locale === 'en' ? 'Copy article link' : '复制文章链接'}}</button></block>
 <block wx:elif="{{sheet === 'city'}}"><button wx:for="{{cities}}" wx:key="id" class="choice-row {{city === item.id ? 'chosen' : ''}}" data-id="{{item.id}}" bindtap="selectCity"><view><text>{{locale === 'en' ? item.en : item.zh}}</text><text class="meta">{{locale === 'en' ? item.zh : item.en}}</text></view><text>{{city === item.id ? '✅' : ''}}</text></button></block>
 <block wx:elif="{{sheet === 'language'}}"><button class="choice-row" data-locale="zh-CN" bindtap="selectLanguage"><view><text>简体中文</text><text class="meta">Chinese (Simplified)</text></view><text>{{locale !== 'en' ? '✅' : ''}}</text></button><button class="choice-row" data-locale="en" bindtap="selectLanguage"><view><text>English</text><text class="meta">English</text></view><text>{{locale === 'en' ? '✅' : ''}}</text></button></block>
 <block wx:elif="{{sheet === 'notifications'}}"><view class="settings-row"><view class="settings-icon"><text class="emoji-icon" aria-hidden="true">{{icons.bell}}</text></view><text class="settings-label">{{t.notificationSettings}}</text><switch checked="{{record.notification_preferences.enabled}}" color="#B0A137" data-kind="notifications" bindchange="preference"/></view><text class="meta">{{record.notification_preferences.enabled ? (locale === 'en' ? 'Notifications enabled' : '已开启通知') : (locale === 'en' ? 'Notifications disabled' : '已关闭通知')}}</text></block>
 <block wx:elif="{{sheet === 'mini'}}"><text class="brand mini-logo">706</text><button class="menu-item" data-kind="about" bindtap="sheet">{{sheetCopy.titles.about}} ›</button><button class="menu-item" bindtap="reloadPage">{{locale === 'en' ? 'Reload page' : '重新加载页面'}} ›</button><button class="menu-item" data-route="feedback" bindtap="navigate">{{t.feedback}} ›</button></block>
 <block wx:elif="{{sheet === 'about'}}"><text class="brand mini-logo">706</text><text class="body-text">{{sheetCopy.descriptions.mini}}</text></block>
 <block wx:elif="{{sheet === 'manage'}}"><button class="menu-item" data-route="edit-entity" data-id="{{record.id}}" bindtap="navigate">{{t.edit}} ›</button><button class="menu-item" data-route="approvals" bindtap="navigate">{{t.approvals}} ›</button><button wx:if="{{record.can_admin}}" class="menu-item" data-route="admins" data-id="{{record.id}}" bindtap="navigate">{{t.admins}} ›</button></block>
 <block wx:elif="{{sheet === 'member'}}"><button class="menu-item" data-value="{{'/pages/member/index?id=' + record.owner}}" bindtap="copy">{{locale === 'en' ? 'Copy profile link' : '复制主页链接'}} ›</button><button wx:if="{{record.owner !== currentUser && record.muted}}" class="menu-item" data-op="mute" data-id="{{record.owner}}" data-block-id="{{record.block_id}}" data-enabled="0" bindtap="action">{{t.unmute}} ›</button><button wx:elif="{{record.owner !== currentUser}}" class="menu-item" data-op="mute" data-id="{{record.owner}}" bindtap="action">{{t.mute}} ›</button><button class="menu-item" data-kind="report" bindtap="sheet">{{t.report}} ›</button></block>
 <block wx:elif="{{sheet === 'why'}}"><view wx:for="{{sheetCopy.reasons}}" wx:key="index" class="reason-row"><text class="reason-icon" aria-hidden="true">{{icons.reasons[index]}}</text><view><text class="section-title">{{item[0]}}</text><text class="meta">{{item[1]}}</text></view></view></block>
 <block wx:elif="{{sheet === 'payment'}}"><text class="section-title">{{record.event.title}}</text><view class="payment-total"><text>{{locale === 'en' ? 'Total' : '应付金额'}}</text><text>{{record.event.feeLabel}}</text></view><text wx:if="{{demo}}" class="notice">{{locale === 'en' ? 'Demo payment only. No money is charged.' : '仅模拟本地付款状态，不会扣款。'}}</text><button class="primary" data-op="payment" bindtap="action">{{demo ? (locale === 'en' ? 'Simulate payment' : '模拟付款') : t.pay}}</button></block>
 <block wx:elif="{{sheet === 'group'}}"><view wx:for="{{access.methods}}" wx:key="type"><text class="section-title">{{t[item.type]}}</text><text wx:if="{{demo && item.type === 'GROUP_QR'}}" class="notice">合成演示二维码 · 仅含 DEMO 标识，无真实群信息</text><image wx:if="{{item.type === 'GROUP_QR'}}" class="qr" src="{{item.value}}" mode="widthFix"/><text wx:else class="body-text" selectable>{{item.value}}</text><button wx:if="{{item.type !== 'GROUP_QR' && item.value}}" class="secondary" data-value="{{item.value}}" bindtap="copy">{{t.copy}}</button></view></block>
 <block wx:elif="{{sheet === 'return'}}"><textarea value="{{sheetForm.note}}" placeholder="{{t.note}}" data-key="note" bindinput="sheetInput"/><button class="primary" data-op="review" data-approve="{{false}}" loading="{{busy}}" bindtap="action">{{locale === 'en' ? 'Send requested changes' : '发送修改意见'}}</button></block>
 <block wx:else>
  <block wx:if="{{sheet === 'register'}}"><text class="section-title">{{record.title}}</text><text class="label">{{t.display_name}}</text><input value="{{sheetForm.display_name}}" placeholder="{{t.display_name}}" data-key="display_name" bindinput="sheetInput"/><text class="label">{{t.motivation}}</text><textarea value="{{sheetForm.motivation}}" placeholder="{{t.motivation}}" data-key="motivation" bindinput="sheetInput"/><checkbox-group bindchange="consent"><label class="checkbox-row"><checkbox checked="{{consent}}"/>{{t.privacyConsent}}</label></checkbox-group><checkbox-group bindchange="contactConsent"><label class="checkbox-row"><checkbox checked="{{shareContact}}"/>{{t.shareContact}}</label></checkbox-group></block>
  <block wx:elif="{{sheet === 'comment'}}"><scroll-view scroll-y class="sheet-comments"><view wx:for="{{commentThreads}}" wx:key="id" class="comment-thread"><image class="avatar" src="{{item.author.avatar_url}}"/><view class="comment-content"><view class="comment-heading"><text>{{item.author.display_name}}</text><text class="meta">{{item.display_time}}</text></view><text class="body-text">{{item.text}}</text><button class="text-button" data-kind="comment" data-reply="{{item.id}}" bindtap="sheet">{{t.reply}}</button><view wx:for="{{item.replies}}" wx:for-item="reply" wx:key="id" class="comment-reply"><text>{{reply.author.display_name}}：</text><text>{{reply.text}}</text></view></view></view></scroll-view><text wx:if="{{sheetForm.reply_to}}" class="meta">{{t.reply}}</text><textarea value="{{sheetForm.text}}" placeholder="{{t.comment}}" data-key="text" bindinput="sheetInput"/></block>
  <input wx:elif="{{sheet === 'invite'}}" value="{{sheetForm.user_id}}" placeholder="{{t.user_id}}" data-key="user_id" bindinput="sheetInput"/>
  <textarea wx:else value="{{sheetForm[sheet === 'report' ? 'reason' : 'text']}}" placeholder="{{sheet === 'report' ? t.reason : t.text}}" data-key="{{sheet === 'report' ? 'reason' : 'text'}}" bindinput="sheetInput"/>
  <button class="primary" disabled="{{busy || (sheet === 'register' && !consent)}}" loading="{{busy}}" bindtap="submitSheet">{{sheet === 'register' ? (record.remaining === 0 ? t.waitlist : record.approval_required ? t.apply : t.register) : sheet === 'recommend' ? (locale === 'en' ? 'Publish recommendation' : '发布推荐') : t.confirm}}</button>
 </block>
 <button wx:if="{{sheet !== 'poster'}}" class="secondary sheet-cancel" bindtap="closeSheet">{{sheet === 'group' || sheet === 'why' ? (locale === 'en' ? 'Done' : '完成') : t.cancel}}</button>
</view></view>
