.poster-actions>button{width:100%;margin:0!important}
.month-legend{display:flex;justify-content:space-between;color:var(--calendarLegend);font-size:22rpx;margin-top:18rpx}
.month-legend>text:first-child{color:var(--calendarLegendDot)}

/* Member source order with Sola's compact white profile and separate gray sections. */
.member-toolbar{display:flex;justify-content:flex-end;margin:0 0 12rpx}.member-hero{background:var(--surface);border-radius:24rpx;padding:28rpx;margin-bottom:28rpx}.member-avatar{width:112rpx;height:112rpx}.member-name{display:block;font-size:36rpx;font-weight:600;margin:18rpx 0 16rpx}.member-city{display:flex;align-items:center;gap:8rpx;font-size:24rpx;line-height:1.6;color:var(--muted)}.member-intro{display:block;font-size:26rpx;line-height:1.7;margin-top:12rpx}.member-hero .chips{margin:18rpx 0}.member-hero .chip{font-size:22rpx;padding:8rpx 16rpx}.member-actions{margin:24rpx 0}.screen .member-actions button{flex:1;font-size:26rpx;min-height:68rpx;padding:14rpx 18rpx}.member-stats{display:flex;align-items:center;justify-content:space-between;border-top:1rpx solid var(--line);padding-top:24rpx}.member-stats>view,.screen .member-stats>button{width:33.33%;padding:0;background:transparent;min-height:0;text-align:center;border:0;border-radius:0;line-height:1.5}.member-stats text{display:block;font-size:30rpx;font-weight:600}.member-stats text+text{font-size:22rpx;font-weight:400;color:var(--muted);margin-top:4rpx}.member-section{margin-bottom:32rpx}.member-section>.section-title{display:block;margin-bottom:16rpx}.screen .member-link{display:flex;align-items:center;gap:20rpx;width:100%;text-align:left;background:var(--surface);border:1rpx solid var(--line);padding:22rpx;border-radius:24rpx;margin:0 0 12rpx;line-height:1.5}.member-link .grow{min-width:0}.member-link .section-title{display:block;font-size:26rpx}.member-link .meta{font-size:22rpx;overflow-wrap:anywhere;word-break:break-all}.member-mark{width:72rpx;height:72rpx;border-radius:22rpx;display:flex;align-items:center;justify-content:center;background:var(--control);font-size:26rpx;flex:none}.member-mark.org-mark{background:var(--accentSoft);color:var(--accentText)}.member-mark.space-mark{background:var(--infoSoft);color:var(--info)}

.member-mark.entity-avatar{border-radius:50%}.member-link .meta{font-weight:400}.member-toolbar .small{background:var(--surface);border:1rpx solid var(--line);border-radius:36rpx}

