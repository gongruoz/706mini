/* Override style-v2's button:not([size=mini]) fixed width in native rendering. */
.screen .city,.screen .icon-button,.screen .text-button,.screen .small,.screen .chip{width:auto;min-width:0;flex-shrink:0}
.screen .fab{width:100rpx;min-width:100rpx;height:100rpx}
.screen .row>.primary,.screen .row>.secondary,.screen .bottom-actions>.primary,.screen .bottom-actions>.secondary{width:auto;flex:1;min-width:0}
.screen .error>text{display:block}

.demo-banner{padding:18rpx 24rpx;background:#DFF8EB;color:#244C39;font-size:24rpx;border-radius:16rpx;margin-bottom:20rpx;}

.screen .catalog-button{width:100%;justify-content:space-between;text-align:left;font-size:28rpx;font-weight:400;border-radius:0;background:#fff;white-space:normal;line-height:1.5;}

