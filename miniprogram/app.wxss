.settings-menu{margin:24rpx 0}.settings-row{display:flex!important;align-items:center;gap:18rpx;width:100%;min-height:100rpx;padding:22rpx 24rpx!important;border-radius:24rpx!important;margin-bottom:12rpx!important;background:#f8f8fa!important;text-align:left!important;font-size:28rpx!important;font-weight:500!important}.settings-icon{display:flex;align-items:center;justify-content:center;width:60rpx;height:60rpx;flex:none;background:#fff;border-radius:16rpx;color:#8b9095;font-size:26rpx}.settings-label{flex:1;min-width:0}.settings-label>text{display:block}.settings-value{font-size:23rpx;color:var(--muted);max-width:230rpx;text-align:right;font-weight:400}.settings-chevron{color:#9b9fa3;font-size:36rpx;flex:none}.self-profile{background:var(--surface);border-radius:28rpx;padding:28rpx}.self-identity{display:flex;gap:20rpx;align-items:center;flex:1;min-width:0}.self-identity .hero-title{font-size:36rpx;margin:0 0 10rpx}.self-identity .avatar{width:100rpx;height:100rpx}.self-profile .small{font-size:22rpx;flex:none}.self-stats{display:flex;margin-top:26rpx}.self-stats button{flex:1;background:transparent;padding:12rpx;display:flex;flex-direction:column;gap:6rpx}.self-stats text:first-child{font-size:38rpx}.self-stats text:last-child{font-size:24rpx;color:var(--muted)}.admin-summary{display:flex;align-items:center;justify-content:space-between;width:100%;padding:26rpx;margin:24rpx 0;background:var(--accent);text-align:left;border-radius:24rpx}.admin-summary .meta{color:#38594a;font-weight:400}.admin-count{font-size:36rpx;padding:16rpx}.settings-logout{width:100%;margin:36rpx 0;background:transparent;color:var(--danger);border:1rpx solid var(--danger);font-size:28rpx;font-weight:400}

.settings-glyph{width:36rpx;height:36rpx;background-size:contain;background-repeat:no-repeat}.settings-logout{border-radius:99rpx!important}

.notification-card{padding:26rpx 28rpx;border-radius:30rpx}.notification-top{gap:10rpx;margin-bottom:14rpx}.notification-avatar,.notification-system-icon{width:30rpx;height:30rpx;border-radius:50%;flex:none}.notification-system-icon{display:flex;align-items:center;justify-content:center;background:#f0f1f2}.notification-system-icon .settings-glyph{width:24rpx;height:24rpx}.notification-source,.notification-time{font-size:21rpx;color:#909397}.notification-time{margin-left:0}.notification-top .unread-dot{margin-left:auto}.notification-title{display:block;font-size:28rpx;font-weight:500;line-height:1.45;margin-bottom:8rpx}.notification-body{display:block;font-size:27rpx;line-height:1.6;color:#747a80}.notification-event-link{color:#7e96cb}
/* Beat native style-v2 button:not([size=mini]) width, as for existing full-width rows. */
.screen .settings-row,.screen .admin-summary,.screen .settings-logout{width:100%!important;max-width:100%;min-width:0}

/* Event detail: prototype order, Sola hierarchy and fixed action rail. */
.detail-facts{padding:20rpx 0;border-top:1rpx solid var(--line);border-bottom:1rpx solid var(--line)}.detail-fact{display:flex;align-items:flex-start;gap:20rpx;padding:16rpx 0}.detail-fact>.glyph{margin-top:6rpx;width:34rpx;height:34rpx}.fact-main{display:block;font-size:28rpx;font-weight:600}.detail-social{padding:20rpx 0 28rpx;gap:18rpx}.social-names{font-weight:600}.detail-intro>.event-status{border-radius:4rpx;padding:4rpx 8rpx}.screen .detail-recommend{display:flex;gap:12rpx;align-items:center;justify-content:center;flex:none;width:auto;min-width:180rpx}.detail-recommend .glyph{width:30rpx;height:30rpx}.section>.member-row{border:1rpx solid var(--line);border-radius:24rpx;padding:24rpx;margin-top:18rpx}.venue-mark{display:flex;align-items:center;justify-content:center;width:72rpx;height:72rpx;border-radius:50%;background:var(--accentSoft);flex:none}.venue-mark .glyph{width:36rpx;height:36rpx}.section .comment .body-text{margin-left:84rpx}.section .comment .comment-reply{margin-left:84rpx}.section .comment>.row:last-child{margin-left:76rpx}.section-heading>.text-button{margin-left:auto!important;flex:none;width:auto!important}.detail-intro .banner{font-size:28rpx}.screen.has-bottom .detail-cover{height:640rpx;border-radius:24rpx}

.screen .comment-content>.text-button{display:inline-block;width:auto!important;min-width:0;margin:0!important;padding:8rpx 0;text-align:left}

.screen .section>button.member-row{width:100%!important;max-width:100%;text-align:left;font-weight:400;background:var(--surface);display:flex;align-items:center;gap:20rpx}

.screen button.detail-campaign,.screen button.detail-location{width:100%!important;text-align:left;font-weight:400}.screen button.detail-location{background:transparent;border-radius:0;padding:16rpx 0}.detail-campaign .meta{margin:0 0 6rpx;color:var(--accentText)}

/* Series: prototype hero/actions/resources order, Sola Pop-up City container and cards. */
.series-hero{position:relative;overflow:hidden;border-radius:28rpx;min-height:360rpx;display:flex;align-items:flex-end}.series-art,.series-tint{position:absolute;inset:0;width:100%;height:100%}.series-tint{background:linear-gradient(100deg,#e2f7edee,#f1f4e5bb,#e1edf5bb)}.series-copy{position:relative;padding:40rpx 28rpx}.series-kicker{font-size:24rpx;color:var(--muted);display:block}.series-copy .hero-title{font-size:42rpx;margin:14rpx 0}.series-cities{font-size:24rpx;line-height:1.7;display:block}.series-actions{margin:24rpx 0}.series-about{border-bottom:1rpx solid var(--line)}.screen .series-resource{display:flex;align-items:center;gap:20rpx;width:100%!important;text-align:left;padding:24rpx;background:var(--surface);border-radius:24rpx;font-weight:400}.series-resource .section-title{font-size:28rpx}.screen .event-title-link{display:-webkit-box;width:100%!important;background:transparent;padding:0;text-align:left;line-height:1.4;border-radius:0}

.series-edit .media-grid{display:flex;flex-wrap:wrap}.series-edit .series-cover-tile{width:440rpx;height:440rpx;margin:0 auto 20rpx}.series-edit .series-cover-tile image{width:100%;height:100%}.series-edit .media-remove{z-index:1}.series-edit .checkbox-row{align-items:flex-start}.series-edit .checkbox-row>view{flex:1;min-width:0}.series-edit .checkbox-row text{white-space:normal}
/* Receipt actions retain legible disabled states and full-width cancellation. */
.page-event-access .next-step .small[disabled]{background:var(--control)!important;color:var(--muted)!important;opacity:1!important}
.page-event-access .access-cancel{width:100%!important;box-sizing:border-box}
/* Calendar uses the neutral interaction-reference variant (19610:85309 / 19604:82751). */
.page-calendar .filters>.chips:first-child{display:flex;align-items:center}
.page-calendar .calendar-export{margin-left:auto!important;flex:none}
.page-calendar .calendar-period{font-size:26rpx;margin:8rpx 0 22rpx}
.page-calendar .calendar-box{background:var(--canvas);padding:0;border-radius:0}
.page-calendar .calendar-grid{border-left:1rpx solid var(--calendarGrid)}
.day-number{display:block;background:transparent;color:inherit;padding:0!important;line-height:1.5;font-size:24rpx;font-weight:500;width:100%!important;border-radius:0}
.day-number[disabled]{opacity:0}
.page-calendar .week-calendar .day{border:0;border-radius:18rpx;height:94rpx;margin:0 4rpx;background:var(--control)}
.page-calendar .week-calendar .day.selected{background:var(--calendarSelected);color:var(--surface);box-shadow:none}
.page-calendar .week-calendar .day.selected .dot{color:var(--calendarDot)}
.page-calendar .month-calendar .day{height:156rpx;border-color:var(--calendarGrid)}
.page-calendar .month-calendar .day-number{font-size:20rpx;text-align:left;padding-left:8rpx!important}
.page-calendar .month-event{font-size:17rpx;font-weight:400;background:var(--calendarEvent);line-height:1.3;padding:2rpx 4rpx!important;text-align:left;min-height:0;color:var(--calendarMonthInk)}
.page-calendar .calendar-caption{font-size:20rpx}
.page-calendar .calendar-results-title{margin:24rpx 0 8rpx}
.page-calendar .timeline-viewport,.page-calendar .calendar-timeline{background:var(--canvas);border-radius:0}
.page-calendar .timeline-grid{border-color:var(--calendarGrid)}
.page-calendar .hour-rule{border-color:var(--calendarGrid)}
.page-calendar .time-scale>text{font-size:20rpx;color:var(--calendarAxis)}
.page-calendar .timeline-event{background:var(--calendarEvent);border:2rpx solid var(--canvas);border-radius:6rpx;color:var(--calendarEventInk);font-size:21rpx;font-weight:400}
.page-calendar .timeline-title{font-size:25rpx;font-weight:500}
.page-calendar .timeline-date{font-size:23rpx;font-weight:500}

.page-calendar .timeline-columns{padding-bottom:70rpx}
.page-calendar button.timeline-event{margin:0!important;text-align:left;line-height:1.45}
.page-calendar .overview-nav .text-button{font-size:34rpx;padding:0 18rpx}

/* Keep calendar poster actions above the home indicator while the image scrolls. */
.poster-sheet{height:88vh;display:flex;flex-direction:column;overflow:hidden}
.poster-sheet>.section-heading,.poster-sheet>.sheet-handle,.poster-sheet>.section-title,.poster-sheet>.meta{flex-shrink:0}
.poster-scroll{flex:1;height:0;min-height:0;margin-top:18rpx}
