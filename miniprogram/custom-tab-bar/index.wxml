<view wx:if="{{!hidden}}" class="navigation-shell" style="{{theme}}">
 <view class="navigation-capsule" role="tablist">
  <view class="navigation-selection" style="transform:translateX({{selected * 100}}%)"/>
  <button wx:for="{{items}}" wx:key="key" class="navigation-tab {{selected === index ? 'is-current' : ''}}" role="tab" aria-selected="{{selected === index}}" aria-label="{{item.label}}" data-index="{{index}}" bindtap="switchTab" hover-class="navigation-pressed">
   <text class="navigation-emoji" aria-hidden="true">{{item.emoji}}</text>
   <text>{{item.label}}</text>
  </button>
 </view>
</view>
