.navigation-shell{position:fixed;left:0;right:0;bottom:0;z-index:15;padding:16rpx var(--pageGutter) calc(8rpx + env(safe-area-inset-bottom));background:linear-gradient(to bottom,var(--chromeClear) 0,var(--canvas) 16rpx,var(--canvas) 100%);color:var(--ink);pointer-events:none}
.navigation-capsule{box-sizing:border-box;position:relative;display:flex;padding:6rpx 10rpx;border:var(--stroke) solid var(--outline);border-radius:var(--pill);background:var(--surface);pointer-events:auto}
.navigation-selection{position:absolute;top:10rpx;bottom:10rpx;left:10rpx;width:calc((100% - 20rpx) / 4);box-sizing:border-box;border:var(--stroke) solid var(--line);border-radius:var(--pill);background:var(--accent);pointer-events:none}
.navigation-capsule>.navigation-tab{box-sizing:border-box;position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2rpx;flex:1;min-width:0;min-height:var(--tabHeight);width:auto;margin:0;padding:8rpx 2rpx;background:transparent;border-radius:var(--pill);color:var(--muted);font-size:22rpx;line-height:1.2;font-weight:400}
.navigation-tab::after{border:0}.navigation-tab.is-current{color:var(--ink);font-weight:600}
.navigation-emoji{display:block;width:64rpx;height:48rpx;line-height:48rpx;text-align:center;font-family:'Apple Color Emoji','Segoe UI Emoji',sans-serif;font-size:var(--tabIconSize);font-weight:400}
.navigation-pressed{opacity:.65}
