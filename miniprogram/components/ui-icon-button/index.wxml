<button size="mini" style="{{theme}};display:flex;align-items:center;justify-content:center;margin:0;padding:0;width:{{hitSize}}px;height:{{hitSize}}px;flex:0 0 {{hitSize}}px" class="ui-icon-button {{disabled ? 'is-disabled' : ''}}" aria-label="{{label}}" disabled="{{disabled}}" hover-class="is-pressed" bindtap="onPress">
 <view class="ui-icon-button-face surface-{{surface}}" style="width:{{size}}px;height:{{size}}px"><image class="ui-icon-button-glyph" src="{{icon}}" aria-hidden="true"/></view>
</button>
